APP_NAME = "Recruitment System"
APP_VERSION = "1.0.0"

DATABASE_URL = "postgresql://postgres:12345@localhost:5432/recruitment_system_db"

# JWT Configuration
SECRET_KEY = "your-super-secret-jwt-key-change-in-production"

FILE_ALLOWED_TYPES = ["text/plain", "application/pdf"]
FILE_MAX_SIZE = 10
FILE_DEFAULT_CHUNK_SIZE = 512000

OLLAMA_BASE_URL = "http://localhost:11434"
OLLAMA_MODEL = "llama3.1"
OLLAMA_TIMEOUT_SEC = 60

OPENAI_API_KEY = "your-openai-api-key"

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID = "your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET = "your-linkedin-client-secret"
LINKEDIN_REDIRECT_URI = "http://localhost:8000/api/v1/auth/linkedin/callback"

# Celery / Redis
# Used by both the Beat scheduler and the worker processes.
REDIS_URL = "redis://localhost:6379/0"
